# Copia questo file in src/.env e personalizza i valori.

# Una o più chiavi Groq, separate da virgole e senza spazi.
GROQ_API_KEYS=YOUR_GROQ_API_KEY

# Dominio da elaborare: rfc oppure ww1.
DOMAIN=rfc

# Usa il reranker Cross-Encoder locale; False usa il modello Groq.
USE_LOCAL_RERANKER=True

# Dispositivo per gli embedding: cpu oppure cuda.
EMBEDDING_DEVICE=cpu

# Dimensione del batch per gli embedding (opzionale).
EMBED_BATCH_SIZE=16

# Modello Ollama usato come giudice nella fase generativa.
JUDGE_MODEL=llama3.1:8b

# Endpoint OpenAI-compatible del modello locale.
LOCAL_LLM_URL=http://localhost:11434/v1
